    "pwd-fs": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^25.6.0",
    "fwa": "^2.1.0",
    "ts-proto": "^2.11.6",
    "typescript": "^7.0.2"
