{
  "name": "t-invest-node-sdk",
  "version": "0.4.1",
  "private": true,
  "description": "Node.js SDK for T-Invest API",
  "keywords": [
    "t-invest",
    "invest",
    "sdk",
    "grpc",
    "protobuf"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/t-invest-node-sdk.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "t-invest-node-sdk": "dist/bootstrap/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "fwa --prune",
    "lint": "oxlint src",
    "cli": "node dist/bootstrap/index.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "icore": "^2.2.1",
    "nice-grpc": "^2.1.17",
    "pwd-fs": "^3.5.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "fwa": "^2.1.3",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ts-proto": "^2.12.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true
  }
}
