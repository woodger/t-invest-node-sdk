{
  "name": "tinkoff-invest-node-sdk",
  "version": "0.3.6",
  "private": true,
  "description": "Node.js SDK for Tinkoff Invest API",
  "keywords": [
    "tinkoff",
    "invest",
    "sdk",
    "grpc",
    "protobuf"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/tinkoff-invest-node-sdk.git"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
