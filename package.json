{
  "name": "@woodger/t-invest-node-sdk",
  "version": "0.5.8",
  "description": "Node.js SDK for T-Invest API",
  "keywords": [
    "t-invest",
    "invest",
    "sdk",
    "grpc",
    "protobuf"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/t-invest-node-sdk.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "t-invest-node-sdk": "dist/bootstrap/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "oxlint src",
    "cli": "node dist/bootstrap/index.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "icore": "^3.0.1",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "pwd-fs": "^3.5.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fwa": "^2.1.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "protoc": "36.2.0",
    "ts-proto": "^2.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
