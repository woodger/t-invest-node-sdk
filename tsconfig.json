{
  "compilerOptions": {
    "lib": [
      "ES2023", "DOM"
    ],
    "target": "es2023",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  }
}
